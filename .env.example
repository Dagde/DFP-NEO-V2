# Copy this file to .env for local database-backed checks.
# Do not commit real credentials.

# Use a local or staging Postgres database for DB smoke tests.
# Do not point archive-retention tests at production unless you deliberately intend to.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dfp_neo_dev"

# Daily snapshot full JSON retention before compact archive pruning.
DFP_FULL_SNAPSHOT_RETENTION_DAYS=90

# Number of eligible snapshots pruned per pass.
DFP_FULL_SNAPSHOT_PRUNE_BATCH=5

# Set to true to disable automatic daily snapshot pruning.
DFP_DISABLE_DAILY_SNAPSHOT_PRUNING=false
