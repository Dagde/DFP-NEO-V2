generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String                @id @default(cuid())
  username        String                @unique
  email           String?               @unique
  password        String
  role            Role                  @default(USER)
  firstName       String?
  lastName        String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  lastLogin       DateTime?
  isActive        Boolean               @default(true)
  mustChangePassword Boolean             @default(false)
  activationCodeHash String?
  activationCodeExpiresAt DateTime?
  activationCodeSentAt DateTime?
  activationCodeUsedAt DateTime?
  activationAttemptCount Int             @default(0)
  activationLockedUntil DateTime?
  createdById     String?
  userId          String                @unique
  aircraft        Aircraft[]            @relation("Aircraft")
  AuditLog        AuditLog[]
  cancellations   CancellationHistory[] @relation("CancellationHistory")
  flightSchedules FlightSchedule[]      @relation("FlightSchedules")
  personnel       Personnel?            @relation("Personnel")
  schedules       Schedule[]
  sessions        Session[]
  trainees        Trainee?              @relation("Trainee")
  createdBy       User?                 @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers    User[]                @relation("UserCreatedBy")
  settings        UserSettings?

  @@index([email])
  @@index([username])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([action])
  @@index([entityType])
  @@index([userId])
}

model Schedule {
  id        String   @id @default(cuid())
  userId    String
  date      String
  data      Json
  version   String   @default("flight-school")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, version])
  @@index([userId])
  @@index([date])
}

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DataBackup {
  id        String   @id @default(cuid())
  type      String
  data      Json
  createdAt DateTime @default(now())
  userId    String?

  @@index([type])
  @@index([createdAt])
}

model FlightSchedule {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  scheduleData Json
  version      String   @default("1.0")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation("FlightSchedules", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([userId, date])
}

model Personnel {
  id                      String   @id @default(cuid())
  userId                  String?  @unique
  name                    String
  rank                    String?
  role                    String?
  qualifications          Json?
  availability            Json?
  preferences             Json?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  callsignNumber          Int?
  category                String?
  email                   String?
  flight                  String?
  idNumber                Int      @unique
  isAdminStaff            Boolean  @default(false)
  isCFI                   Boolean  @default(false)
  isCommandingOfficer     Boolean  @default(false)
  isContractor            Boolean  @default(false)
  isDeputyFlightCommander Boolean  @default(false)
  isExecutive             Boolean  @default(false)
  isFlyingSupervisor      Boolean  @default(false)
  isIRE                   Boolean  @default(false)
  isOFI                   Boolean  @default(false)
  isQFI                   Boolean  @default(false)
  isTestingOfficer        Boolean  @default(false)
  location                String?
  permissions             String[] @default([])
  phoneNumber             String?
  priorExperience         Json?
  seatConfig              String?
  service                 String?
  unavailability          Json?
  unit                    String?
  photoUrl                String?
  user                    User?    @relation("Personnel", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([idNumber])
  @@index([role])
  @@index([isActive])
}

model Trainee {
  id                  String    @id @default(cuid())
  userId              String?   @unique
  idNumber            Int       @unique
  name                String
  fullName            String
  rank                String?
  role                String?
  service             String?
  course              String?
  lmpType             String?   @default("")
  academicLmpType     String?   @default("")
  traineeCallsign     String?
  seatConfig          String?
  isPaused            Boolean   @default(false)
  unavailability      Json?
  unit                String?
  flight              String?
  location            String?
  phoneNumber         String?
  email               String?
  photoUrl            String?
  primaryInstructor   String[]  @default([])
  secondaryInstructor String[]  @default([])
  lastEventDate       DateTime?
  lastFlightDate      DateTime?
  currencyStatus      Json?
  permissions         String[]  @default([])
  priorExperience     Json?
  preferences         Json?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  scores              Score[]   @relation("TraineeScores")
  individualLMP       IndividualLMP?  @relation("TraineeLMP")
  eventCompletions    EventCompletion[] @relation("TraineeEventCompletions")
  user                User?     @relation("Trainee", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([idNumber])
  @@index([course])
  @@index([unit])
  @@index([isActive])
}

model Aircraft {
  id             String   @id @default(cuid())
  userId         String
  aircraftNumber String
  type           String
  status         String   @default("available")
  configuration  Json?
  maintenanceLog Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation("Aircraft", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, aircraftNumber])
  @@index([userId])
  @@index([status])
  @@index([isActive])
}

model CancellationHistory {
  id               String   @id @default(cuid())
  userId           String
  scheduleId       String?
  eventId          String
  eventType        String
  cancellationCode String
  reason           String?
  cancelledBy      String
  cancelledAt      DateTime @default(now())
  originalData     Json
  user             User     @relation("CancellationHistory", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scheduleId])
  @@index([cancelledAt])
  @@index([cancellationCode])
}

model Course {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  startDate     String
  endDate       String
  totalStudents Int?
  raafCount     Int?
  navyCount     Int?
  armyCount     Int?
  location      String
  unit          String
  lmpType       String?
  academicLmpType String?
  courseCommander String?
  deputyCourseCommander String?
  status        String   @default("ACTIVE")
  color         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Score {
  id         String   @id @default(cuid())
  traineeId  String
  event      String
  score      Int
  date       DateTime
  instructor String
  notes      String?
  details    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  trainee    Trainee  @relation("TraineeScores", fields: [traineeId], references: [id], onDelete: Cascade)
}

// Individual Learning Management Plan - one record per trainee
// Stores their full syllabus with completion status persisted in DB
model IndividualLMP {
  id                String   @id @default(cuid())
  traineeId         String   @unique
  traineeFullName   String
  lmpType           String
  events            Json
  completedEventIds String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  trainee           Trainee  @relation("TraineeLMP", fields: [traineeId], references: [id], onDelete: Cascade)

  @@index([traineeFullName])
  @@index([traineeId])
}

model SctRequest {
  id             String   @id @default(cuid())
  userId         String
  requestType    String   @default("flight") // "flight" or "ftd"
  name           String
  event          String
  eventCode      String?  @default("")
  flightType     String   @default("Dual")
  currency       String   @default("")
  currencyExpire String   @default("")
  priority       String   @default("Medium")
  notes          String?
  dateRequested  String?
  requestedTime  String?
  dayNight       String?  @default("Day")
  submitted      Boolean  @default(false)
  includeInBuild Boolean  @default(false)
  aircraftConfigId String? @default("CONFIG-0")
  acceptableAircraftConfigs Json? @default("[]")
  crewMember     String?  @default("")
  crewGroup      String?  @default("")
  crewGroupKey   String?  @default("")
  crewUnitCode   String?  @default("")
  crewDisplayLabel String? @default("")
  crewIndividual String?  @default("")
  aircraftCount  Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([priority])
  @@index([requestType])
}

// DailySnapshot: One record per date, saved when a schedule is published.
// Contains a full snapshot of all training data as-of end-of-day for that date.
model DailySnapshot {
  id               String   @id @default(cuid())
  date             String   @unique  // YYYY-MM-DD
  scheduleEvents   Json     // All published schedule events for that date
  staffEvents      Json     // Staff/instructor events filtered from schedule
  traineeEvents    Json     // Trainee events filtered from schedule
  pt051Assessments Json     // Legacy Training Report records as of that date
  traineeProfiles  Json     // Trainee profiles with performance history
  staffProfiles    Json     @default("[]") // Staff assigned to the unit/location as of that snapshot date
  lmpCompletedIds  Json     // { traineeFullName: string[] } - completedEventIds per trainee
  staffCurrency    Json     // { personnelName: currencyStatus[] } per staff member
  staffLogbook     Json     // Logbook entries (flight times) from publishedSchedules for staff
  savedAt          DateTime @default(now())
  savedBy          String?  // userId who published

  @@index([date])
  @@index([savedAt])
}

// CourseSettings: Global course-related settings
// Stores academic LMP selection and course exclusions used by NEO Build.
model CourseSettings {
  id                  String   @id @default(cuid())
  selectedAcademicLmp String?
  excludedCourses     String   @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// CourseAcademicProgress: Tracks course-level academic event completion
// Used when entire course cohort marks an academic event as complete (✅ in AcademicsTab)
model CourseAcademicProgress {
  id             String   @id @default(cuid())
  courseCode     String   // Course code (e.g., "ADF301", "BPC", "FIC210")
  lessonCode     String   // Syllabus item code for the academic event
  completedDate  DateTime @default(now())
  completedBy    String?  // userId who marked it complete

  @@unique([courseCode, lessonCode])
  @@index([courseCode])
  @@index([lessonCode])
}

model AppSettings {
  id        String   @id @default(cuid())
  orgId     String   @unique @default("default")
  data      Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

model EventCompletion {
  id              String   @id @default(cuid())
  scheduleEventId String   @unique
  eventCode       String
  eventDate       String
  eventType       String   @default("flight")
  startTime       Float    @default(0)
  duration        Float    @default(0)
  traineeId       String?
  traineeFullName String
  instructorName  String?
  dcoResult       String
  overallGrade    Int?
  overallResult   String?
  aircraftNumber  String?
  takeoffTime     String?
  landTime        String?
  totalFlightTime Float?
  isSolo          Boolean  @default(false)
  isDual          Boolean  @default(false)
  isCountedAsElce Boolean  @default(true)
  recordedBy      String?
  source          String   @default("post_flight")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  trainee         Trainee? @relation("TraineeEventCompletions", fields: [traineeId], references: [id], onDelete: SetNull)

  @@index([traineeId])
  @@index([traineeFullName])
  @@index([eventDate])
  @@index([eventCode])
  @@index([dcoResult])
  @@index([traineeFullName, eventDate])
}

model FlightLogEntry {
  id              String   @id @default(cuid())
  scheduleEventId String
  eventCode       String
  eventDate       String
  eventType       String   @default("flight")
  traineeId       String?
  personnelId     String?
  personName      String
  personRole      String
  aircraftNumber  String?
  fromIcao        String?
  toIcao          String?
  duty            String?
  isSolo          Boolean  @default(false)
  isDual          Boolean  @default(false)
  isFlightLog     Boolean  @default(true)
  isFtdLog        Boolean  @default(false)
  takeoffTime     String?
  landTime        String?
  totalTime       Float?
  captainTime     Float?
  instructorTime  Float?
  nightTime       Float?
  ifActualTime    Float?
  ifSimTime       Float?
  ineffectiveTime Float?
  ilsCount        Int      @default(0)
  rnpCount        Int      @default(0)
  tacanCount      Int      @default(0)
  vorCount        Int      @default(0)
  captainLogSnapshot Json?
  crewLogSnapshot    Json?
  recordedBy      String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([scheduleEventId])
  @@index([traineeId])
  @@index([personnelId])
  @@index([personName])
  @@index([eventDate])
  @@index([eventCode])
  @@index([scheduleEventId, personRole])
}

model CommercialOrganisation {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  status    String   @default("ACTIVE")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommercialLocation {
  id               String   @id @default(cuid())
  organisationCode String
  code             String   @unique
  iataCode         String?
  name             String
  timezoneOffset   Int      @default(10)
  trainingAreas    String[] @default([])
  status           String   @default("ACTIVE")
  settings         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organisationCode])
  @@index([status])
}

model CommercialUnit {
  id               String   @id @default(cuid())
  organisationCode String
  locationCode     String
  code             String   @unique
  name             String
  unitType         String   @default("Training")
  status           String   @default("ACTIVE")
  settings         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organisationCode])
  @@index([locationCode])
  @@index([unitType])
  @@index([status])
}

model CommercialAircraftType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  category  String   @default("Training")
  status    String   @default("ACTIVE")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model CommercialResourcePool {
  id               String   @id @default(cuid())
  organisationCode String
  locationCode     String?
  unitCode         String?
  aircraftTypeCode String?
  code             String   @unique
  name             String
  poolType         String   @default("Dedicated")
  status           String   @default("ACTIVE")
  settings         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organisationCode])
  @@index([locationCode])
  @@index([unitCode])
  @@index([aircraftTypeCode])
  @@index([poolType])
}

model CommercialModule {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CommercialUnitModule {
  id        String   @id @default(cuid())
  unitCode  String
  moduleCode String
  isEnabled Boolean  @default(true)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitCode, moduleCode])
  @@index([unitCode])
  @@index([moduleCode])
}

model CommercialLicense {
  id                 String    @id @default(cuid())
  organisationCode   String
  licenseKey         String    @unique
  licenseName        String
  deploymentMode     String    @default("Online SaaS")
  status             String    @default("ACTIVE")
  validFrom          DateTime?
  validUntil         DateTime?
  maxUsers           Int?
  maxUnits           Int?
  maxAircraftTypes   Int?
  moduleCodes        String[]  @default([])
  features           Json      @default("{}")
  offlineFingerprint String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([organisationCode])
  @@index([status])
}

model CommercialUserAccess {
  id               String   @id @default(cuid())
  userId           String
  username         String?
  displayName      String?
  organisationCode String   @default("DEFAULT")
  locationCode     String?
  unitCode         String?
  moduleCode       String?
  scopeKey         String   @unique
  role             String   @default("Viewer")
  accessLevel      String   @default("Read")
  status           String   @default("ACTIVE")
  settings         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([organisationCode])
  @@index([locationCode])
  @@index([unitCode])
  @@index([moduleCode])
  @@index([status])
}

model CommercialSchedulingRuleSet {
  id               String   @id @default(cuid())
  organisationCode String
  unitCode         String?
  aircraftTypeCode String?
  name             String
  scope            String   @default("Unit")
  rules            Json     @default("{}")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organisationCode])
  @@index([unitCode])
  @@index([aircraftTypeCode])
  @@index([scope])
  @@index([isActive])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PILOT
  INSTRUCTOR
  USER
}
