# Database URLs
DATABASE_URL="postgresql://user:password@host:5432/dfp_neo_primary"
BACKUP_DATABASE_URL="postgresql://user:password@host:5432/dfp_neo_backup"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# CORS / browser origin allow-list
# Comma-separated frontend origins allowed to call this API from a browser.
# Include the production website and any private/offline server URL used by customers.
DFP_NEO_ALLOWED_ORIGINS="https://dfp-neo.com,https://dfp-neo-v2-production.up.railway.app,http://localhost:3000"

# Optional external weather provider
# Required only when Settings -> Data Sources permits live TAF weather.
AVWX_API_TOKEN="your-avwx-api-token"

# Initial Administrator User (for seed script)
INITIAL_ADMIN_USERID="admin"
INITIAL_ADMIN_PASSWORD="ChangeMe123!"
INITIAL_ADMIN_EMAIL="admin@example.com"

# Optional: Create sample users for testing
CREATE_SAMPLE_USERS="false"

# Email Configuration (for future use)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="admin@dfp-neo.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="DFP-NEO <noreply@dfp-neo.com>"

# Admin Emails
ADMIN_EMAIL="admin@dfp-neo.com"
DIRECTOR_EMAIL="director@dfp-neo.com"
SUPPORT_EMAIL="support@dfp-neo.com"
MARKETING_EMAIL="marketing@dfp-neo.com"
SUPER_ADMIN_EMAIL="super-admin@dfp-neo.com"
