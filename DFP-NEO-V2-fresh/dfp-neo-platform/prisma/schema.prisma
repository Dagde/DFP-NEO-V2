generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String                @id @default(cuid())
  username        String                @unique
  email           String?               @unique
  password        String
  role            Role                  @default(USER)
  firstName       String?
  lastName        String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  lastLogin       DateTime?
  isActive        Boolean               @default(true)
  createdById     String?
  userId          String                @unique
  aircraft        Aircraft[]            @relation("Aircraft")
  AuditLog        AuditLog[]
  cancellations   CancellationHistory[] @relation("CancellationHistory")
  flightSchedules FlightSchedule[]      @relation("FlightSchedules")
  personnel       Personnel?            @relation("Personnel")
  schedules       Schedule[]
  sessions        Session[]
  trainees        Trainee?              @relation("Trainee")
  createdBy       User?                 @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers    User[]                @relation("UserCreatedBy")
  settings        UserSettings?

  @@index([email])
  @@index([username])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([action])
  @@index([entityType])
  @@index([userId])
}

model Schedule {
  id        String   @id @default(cuid())
  userId    String
  date      String
  data      Json
  version   String   @default("flight-school")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, version])
  @@index([userId])
  @@index([date])
}

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DataBackup {
  id        String   @id @default(cuid())
  type      String
  data      Json
  createdAt DateTime @default(now())
  userId    String?

  @@index([type])
  @@index([createdAt])
}

model FlightSchedule {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  scheduleData Json
  version      String   @default("1.0")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation("FlightSchedules", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([userId, date])
}

model Personnel {
  id                      String   @id @default(cuid())
  userId                  String?  @unique
  name                    String
  rank                    String?
  role                    String?
  qualifications          Json?
  availability            Json?
  preferences             Json?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  callsignNumber          Int?
  category                String?
  email                   String?
  flight                  String?
  idNumber                Int?
  isAdminStaff            Boolean  @default(false)
  isCFI                   Boolean  @default(false)
  isCommandingOfficer     Boolean  @default(false)
  isContractor            Boolean  @default(false)
  isDeputyFlightCommander Boolean  @default(false)
  isExecutive             Boolean  @default(false)
  isFlyingSupervisor      Boolean  @default(false)
  isIRE                   Boolean  @default(false)
  isOFI                   Boolean  @default(false)
  isQFI                   Boolean  @default(false)
  isTestingOfficer        Boolean  @default(false)
  location                String?
  permissions             String[] @default([])
  phoneNumber             String?
  priorExperience         Json?
  seatConfig              String?
  service                 String?
  unavailability          Json?
  unit                    String?
  user                    User?    @relation("Personnel", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([idNumber])
  @@index([role])
  @@index([isActive])
}

model Trainee {
  id                  String    @id @default(cuid())
  userId              String?   @unique
  idNumber            Int       @unique
  name                String
  fullName            String
  rank                String?
  service             String?
  course              String?
  lmpType             String?   @default("BPC+IPC")
  traineeCallsign     String?
  seatConfig          String?
  isPaused            Boolean   @default(false)
  unavailability      Json?
  unit                String?
  flight              String?
  location            String?
  phoneNumber         String?
  email               String?
  primaryInstructor   String?
  secondaryInstructor String?
  lastEventDate       DateTime?
  lastFlightDate      DateTime?
  currencyStatus      Json?
  permissions         String[]  @default([])
  priorExperience     Json?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  scores              Score[]          @relation("TraineeScores")
  individualLMP       IndividualLMP?   @relation("TraineeLMP")
  eventCompletions    EventCompletion[] @relation("TraineeEventCompletions")
  user                User?            @relation("Trainee", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([idNumber])
  @@index([course])
  @@index([unit])
  @@index([isActive])
}

model Aircraft {
  id             String   @id @default(cuid())
  userId         String
  aircraftNumber String
  type           String
  status         String   @default("available")
  configuration  Json?
  maintenanceLog Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation("Aircraft", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, aircraftNumber])
  @@index([userId])
  @@index([status])
  @@index([isActive])
}

model CancellationHistory {
  id               String   @id @default(cuid())
  userId           String
  scheduleId       String?
  eventId          String
  eventType        String
  cancellationCode String
  reason           String?
  cancelledBy      String
  cancelledAt      DateTime @default(now())
  originalData     Json
  user             User     @relation("CancellationHistory", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scheduleId])
  @@index([cancelledAt])
  @@index([cancellationCode])
}

model Course {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  startDate     String
  endDate       String
  totalStudents Int?
  raafCount     Int?
  navyCount     Int?
  armyCount     Int?
  location      String
  unit          String
  status        String   @default("ACTIVE")
  color         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Score {
  id         String   @id @default(cuid())
  traineeId  String
  event      String
  score      Int
  date       DateTime
  instructor String
  notes      String?
  details    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  trainee    Trainee  @relation("TraineeScores", fields: [traineeId], references: [id], onDelete: Cascade)
}

// Individual Learning Management Plan - one record per trainee
// Stores their full syllabus with completion status persisted in DB
model IndividualLMP {
  id             String   @id @default(cuid())
  traineeId      String   @unique  // one LMP per trainee
  traineeFullName String           // denormalised for fast lookup by name
  lmpType        String            // "BPC+IPC" | "FIC" etc
  events         Json              // LMPEvent[] - full syllabus items + completedAt field
  completedEventIds String[]       // fast lookup set of completed event ids (e.g. ["BGF1","BGF2"])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  trainee        Trainee  @relation("TraineeLMP", fields: [traineeId], references: [id], onDelete: Cascade)

  @@index([traineeFullName])
  @@index([traineeId])
}

// Raw event log - every meaningful state change
model AircraftAvailabilityEvent {
  id             String   @id @default(cuid())
  timestamp      DateTime // Exact time of the event
  date           String   // ISO date YYYY-MM-DD (for easy querying)
  availableCount Int      // How many aircraft available at this point
  totalAircraft  Int      // Total fleet size
  changeType     String   // "startup" | "reset" | "change" | "window_start" | "window_end" | "shutdown"
  recordedBy     String?  // userId
  notes          String?
  createdAt      DateTime @default(now())

  @@index([date])
  @@index([timestamp])
  @@index([changeType])
}

// Daily summary table - UI display
model AircraftAvailabilityHistory {
  id               String   @id @default(cuid())
  date             String   // ISO date string YYYY-MM-DD
  dailyAverage     Float    // Time-weighted average aircraft available during flying window
  plannedCount     Int      // Planned availability at start of day
  actualCount      Int?     // Actual count at end of flying window
  totalAircraft    Int      // Total aircraft in fleet
  availabilityPct  Float    // Percentage available (dailyAverage / totalAircraft * 100)
  flyingWindowStart String? // "0800" format
  flyingWindowEnd   String? // "1700" format
  recordedBy       String?  // userId who last triggered recalculation
  notes            String?
  lastCalculatedAt DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([date])
  @@index([date])
  @@index([createdAt])
}

// Organisation-level app settings - persists all settings page data
model AppSettings {
  id        String   @id @default(cuid())
  orgId     String   @unique @default("default")
  data      Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

// ─────────────────────────────────────────────────────────────────────────────
// EventCompletion — DCO-based tracking table
//
// Records the completion outcome (DCO / DPCO / DNCO) of every scheduled
// event whose post-flight form has been submitted.  Serves three purposes:
//
//  1. ELCE support in the build algorithm:
//     The algorithm can query "what is this trainee's last SUCCESSFUL event
//     as of <buildDate>?" without having to scan the entire Schedule JSON
//     blob or wait for a PT-051 Score to be entered.
//
//  2. DCO result history:
//     A permanent, queryable audit trail of every DCO / DPCO / DNCO outcome
//     per trainee, queryable by date range, eventCode, dcoResult, etc.
//
//  3. Reporting / analytics:
//     Completion-rate dashboards, instructor performance analysis, course
//     progress summaries can all be driven from this table.
// ─────────────────────────────────────────────────────────────────────────────
model EventCompletion {
  id              String   @id @default(cuid())

  // ── Event identity ──────────────────────────────────────────────────────
  /// The ScheduleEvent.id from the DFP program JSON (unique per sortie)
  scheduleEventId String   @unique

  /// Syllabus event code, e.g. "BGF2", "BNF1", "BIF3"
  eventCode       String

  /// ISO date of the scheduled sortie (YYYY-MM-DD)
  eventDate       String

  /// Category of training event
  eventType       String   @default("flight")
  // valid values: "flight" | "ftd" | "cpt" | "ground"

  /// Start time as decimal hours (e.g. 9.5 = 09:30 local)
  startTime       Float    @default(0)

  /// Duration as decimal hours
  duration        Float    @default(0)

  // ── Personnel ───────────────────────────────────────────────────────────
  /// FK to Trainee.id — nullable so the record survives if the trainee is
  /// archived.  traineeFullName is always kept for fast lookups.
  traineeId       String?

  /// Denormalised full name — used by ELCE queries and build algorithm
  /// to avoid a join when the trainee FK has been NULLed.
  traineeFullName String

  /// Name of the instructor who conducted the event (denormalised string)
  instructorName  String?

  // ── DCO result (core payload) ────────────────────────────────────────
  /// Primary completion outcome recorded on the post-flight form.
  /// DCO  = Duty Carry Out   (successful completion)
  /// DPCO = Duty Partially Carry Out  (partial completion — counts as ELCE)
  /// DNCO = Duty Not Carry Out        (unsuccessful — does NOT advance ELCE)
  dcoResult       String
  // valid values: "DCO" | "DPCO" | "DNCO"

  /// PT-051 overall grade 0–5, null when not graded (e.g. solo)
  overallGrade    Int?

  /// PT-051 overall result: "P" (pass) | "F" (fail) | null
  overallResult   String?

  // ── Flight log details ──────────────────────────────────────────────
  aircraftNumber  String?
  takeoffTime     String?           // "HH:MM"
  landTime        String?           // "HH:MM"
  totalFlightTime Float?            // decimal hours
  isSolo          Boolean  @default(false)
  isDual          Boolean  @default(false)

  // ── ELCE flag ────────────────────────────────────────────────────────
  /// When true, this record may be used as the Effective Last Completed
  /// Event for the build algorithm's next-event pointer.
  /// Automatically set to false when dcoResult == "DNCO".
  isCountedAsElce Boolean  @default(true)

  // ── Audit / source ──────────────────────────────────────────────────
  /// userId of the person who saved the post-flight form
  recordedBy      String?

  /// How the record was created
  source          String   @default("post_flight")
  // valid values: "post_flight" | "manual" | "import"

  notes           String?

  // ── Timestamps ──────────────────────────────────────────────────────
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ── Relations ───────────────────────────────────────────────────────
  trainee         Trainee? @relation("TraineeEventCompletions", fields: [traineeId], references: [id], onDelete: SetNull)

  // ── Indexes ─────────────────────────────────────────────────────────
  @@index([traineeId])
  @@index([traineeFullName])
  @@index([eventDate])
  @@index([eventCode])
  @@index([dcoResult])
  @@index([traineeFullName, eventDate])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PILOT
  INSTRUCTOR
  USER
}
